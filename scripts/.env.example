# Token 登录配置 - 环境变量方式
# =====================================
# 使用方法:
#   1. 复制此文件为 .env
#   2. 填入真实的认证信息
#   3. 确保 .env 已添加到 .gitignore
#
# 注意: .env 文件包含敏感信息，切勿提交到代码仓库!

# 必填: JWT Token
AUTH_TOKEN=your_jwt_token_here

# 可选: 用户信息 (JSON 格式或简单字符串)
AUTH_USER_INFO={"username": "Your Name", "user_id": "xxx"}

# 可选: Token 过期时间
AUTH_EXPIRES_AT=2026-12-31T23:59:59
